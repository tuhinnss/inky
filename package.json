{
  "name": "calcink",
  "private": true,
  "version": "0.1.0",
  "description": "On-device handwritten math calculator: write an expression, get the answer inline.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "capture": "vite build --mode capture --outDir dist-capture && vite preview --mode capture --outDir dist-capture --host --port 5185 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:digits": "vitest run --config vitest.eval.config.ts pendigits",
    "eval:operators": "vitest run --config vitest.eval.config.ts mathwriting",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "~4.0.18"
  },
  "dependencies": {
    "@fontsource/kalam": "^5.3.0",
    "onnxruntime-web": "^1.30.0",
    "perfect-freehand": "^1.2.3"
  }
}
